# ── Client (exposed to browser — safe: anon key + public URL) ──
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_KEY=YOUR-ANON-PUBLIC-KEY

# ── Server only (used by /api functions — NEVER prefixed with VITE_) ──
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
ADMIN_PASSCODE=change-me-to-something-only-you-know

# ── Order-notification email (optional; via https://resend.com) ──
# If RESEND_API_KEY is unset, orders still work — they just don't email.
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
ORDER_NOTIFY_EMAIL=tom@topteamscore.com
# Sender must be on a domain verified in your Resend account (ludivation.com is).
ORDER_FROM_EMAIL=C-Side Flag Football <orders@ludivation.com>
